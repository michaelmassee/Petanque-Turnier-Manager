<?xml version='1.0' encoding='UTF-8'?>
<!--
    PTM-Online-Toolbar: nur die im laufenden Turnier häufigen Funktionen (Meldungen abgleichen, Konfliktliste,
    Sync pausieren/fortsetzen, Online-Turnier im Browser). Verbinden, Trennen, Zuordnung wiederherstellen und
    Ergebnisse abholen (kommen per Sofort-Signal) gibt es nur im Untermenü PTM-Online.
    Sichtbar nur bei hinterlegtem PTM-Online-Zugang (PtmOnlineToolbarSteuerung).
    Buttons bleiben immer klickbar (LO-Bug tdf#172207, TOOLBAR_ONLY_CMDS); passt der Zustand nicht, erklärt ein
    Hinweis beim Klick, warum nichts passiert. Node-Namen strikt sequenziell (m1, m2, …), siehe CLAUDE.md.
-->
<oor:component-data oor:package="org.openoffice.Office" oor:name="Addons"
                    xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <node oor:name="AddonUI">
        <node oor:name="OfficeToolBar">
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string" oor:localized="true">
                    <value>PétTurnMngr PTM-Online</value>
                    <value xml:lang="de">PétTurnMngr PTM-Online</value>
                    <value xml:lang="en">PétTurnMngr PTM-Online</value>
                    <value xml:lang="es">PétTurnMngr PTM-Online</value>
                    <value xml:lang="fr">PétTurnMngr PTM-Online</value>
                    <value xml:lang="nl">PétTurnMngr PTM-Online</value>
                </prop>
                <prop oor:name="Label" oor:type="xs:string" oor:localized="true">
                    <value>PétTurnMngr PTM-Online</value>
                    <value xml:lang="de">PétTurnMngr PTM-Online</value>
                    <value xml:lang="en">PétTurnMngr PTM-Online</value>
                    <value xml:lang="es">PétTurnMngr PTM-Online</value>
                    <value xml:lang="fr">PétTurnMngr PTM-Online</value>
                    <value xml:lang="nl">PétTurnMngr PTM-Online</value>
                </prop>
                <prop oor:name="Context" oor:type="xs:string">
                    <value>com.sun.star.sheet.SpreadsheetDocument</value>
                </prop>

                <node oor:name="m1" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>ptm:ptmonline_anmeldungen_importieren</value>
                    </prop>
                    <prop oor:name="Title">
                        <value xml:lang="de">Meldungen abgleichen</value>
                        <value xml:lang="en">Synchronize registrations</value>
                        <value xml:lang="es">Sincronizar inscripciones</value>
                        <value xml:lang="fr">Synchroniser les inscriptions</value>
                        <value xml:lang="nl">Inschrijvingen synchroniseren</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                </node>

                <node oor:name="m2" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>ptm:ptmonline_konfliktliste_oeffnen</value>
                    </prop>
                    <prop oor:name="Title">
                        <value xml:lang="de">Konfliktliste öffnen</value>
                        <value xml:lang="en">Open conflict list</value>
                        <value xml:lang="es">Abrir lista de conflictos</value>
                        <value xml:lang="fr">Ouvrir la liste des conflits</value>
                        <value xml:lang="nl">Conflictenlijst openen</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                </node>

                <node oor:name="m3" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>private:separator</value>
                    </prop>
                </node>

                <node oor:name="m4" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>ptm:ptmonline_sync_pausieren</value>
                    </prop>
                    <prop oor:name="Title">
                        <value xml:lang="de">PTM-Online-Sync pausieren</value>
                        <value xml:lang="en">Pause PTM-Online sync</value>
                        <value xml:lang="es">Pausar sincronización PTM-Online</value>
                        <value xml:lang="fr">Mettre la synchronisation PTM-Online en pause</value>
                        <value xml:lang="nl">PTM-Online-synchronisatie pauzeren</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                </node>

                <node oor:name="m5" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>ptm:ptmonline_sync_fortsetzen</value>
                    </prop>
                    <prop oor:name="Title">
                        <value xml:lang="de">PTM-Online-Sync fortsetzen</value>
                        <value xml:lang="en">Resume PTM-Online sync</value>
                        <value xml:lang="es">Reanudar sincronización PTM-Online</value>
                        <value xml:lang="fr">Reprendre la synchronisation PTM-Online</value>
                        <value xml:lang="nl">PTM-Online-synchronisatie hervatten</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                </node>

                <node oor:name="m6" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>private:separator</value>
                    </prop>
                </node>

                <node oor:name="m7" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>ptm:ptmonline_im_browser_oeffnen</value>
                    </prop>
                    <prop oor:name="Title">
                        <value xml:lang="de">Online-Turnier im Browser öffnen</value>
                        <value xml:lang="en">Open online tournament in browser</value>
                        <value xml:lang="es">Abrir torneo en línea en el navegador</value>
                        <value xml:lang="fr">Ouvrir le tournoi en ligne dans le navigateur</value>
                        <value xml:lang="nl">Online toernooi in browser openen</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                    <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
                </node>
            </node>
        </node>

        <node oor:name="Images">
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline.abgleichen" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>ptm:ptmonline_anmeldungen_importieren</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/images/16/toolbar-ptmonline-abgleichen.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/images/24/toolbar-ptmonline-abgleichen.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline.konfliktliste" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>ptm:ptmonline_konfliktliste_oeffnen</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/images/16/toolbar-ptmonline-konfliktliste.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/images/24/toolbar-ptmonline-konfliktliste.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline.pausieren" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>ptm:ptmonline_sync_pausieren</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/images/16/toolbar-ptmonline-sync-pausieren.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/images/24/toolbar-ptmonline-sync-pausieren.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline.fortsetzen" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>ptm:ptmonline_sync_fortsetzen</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/images/16/toolbar-ptmonline-sync-fortsetzen.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/images/24/toolbar-ptmonline-sync-fortsetzen.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline.browser" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>ptm:ptmonline_im_browser_oeffnen</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/images/16/toolbar-ptmonline-browser.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/images/24/toolbar-ptmonline-browser.png</value>
                    </prop>
                </node>
            </node>
        </node>
    </node>
</oor:component-data>
