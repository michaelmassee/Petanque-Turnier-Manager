                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/images/24/toolbar-ptmonline-wiederherstellen.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="de.petanqueturniermanager.toolbar.ptmonline.trennen" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>ptm:ptmonline_verbindung_trennen</value>
                </prop>
                <node oor:name="UserDefinedImages">
