+Color ScCellObj::GetDisplayedBackColor_Impl() const
+{
+    SolarMutexGuard aGuard;
+    ScDocShell* pDocSh = GetDocShell();
+    if (!pDocSh)
+        return COL_TRANSPARENT;
+
+    ScDocument& rDoc = pDocSh->GetDocument();
+    const ScPatternAttr* pPattern = rDoc.GetPattern(aCellPos);
+    if (!pPattern)
+        return COL_TRANSPARENT;
+
+    // Same precedence as ScDocument::FillInfo() uses for painting: a colour
+    // scale wins over the background of a matching condition's cell style,
+    // which in turn wins over the cell's own (direct or style) background.
+    if (const ScConditionalFormatList* pCondList = rDoc.GetCondFormList(aCellPos.Tab()))
+    {
+        ScRefCellValue aCell(rDoc, aCellPos);
+        for (sal_uInt32 nKey : pPattern->GetItem(ATTR_CONDITIONAL).GetCondFormatData())
+        {
+            const ScConditionalFormat* pFormat = pCondList->GetFormat(nKey);
+            if (!pFormat)
+                continue;
+            ScCondFormatData aData = pFormat->GetData(aCell, aCellPos);
+            if (aData.mxColorScale)
+                return *aData.mxColorScale;
+        }
+    }
+
+    const SfxItemSet* pCondSet = rDoc.GetCondResult(aCellPos.Col(), aCellPos.Row(), aCellPos.Tab());
+    return pPattern->GetItem(ATTR_BACKGROUND, pCondSet).GetColor();
+}
+
