 sc/inc/unowids.hxx                      |  3 +-
 sc/qa/unit/ucalc_condformat.cxx         | 65 +++++++++++++++++++++++++
 sc/source/ui/unoobj/cellsuno.cxx        | 40 ++++++++++++++-
 test/source/sheet/sheetcell.cxx         | 12 +++++
 7 files changed, 135 insertions(+), 2 deletions(-)

diff --git a/offapi/com/sun/star/sheet/SheetCell.idl b/offapi/com/sun/star/sheet/SheetCell.idl
index 00d5054fb5b9..5437c2ef3b50 100644
--- a/offapi/com/sun/star/sheet/SheetCell.idl
+++ b/offapi/com/sun/star/sheet/SheetCell.idl
@@ -225,6 +225,20 @@ published service SheetCell
         @since LibreOffice 6.1
      */
     [optional, readonly, property] long FormulaResultType2;
+
+
+    /** contains the background color the cell is actually displayed with.
+
+        <p>Unlike com::sun::star::table::CellProperties::CellBackColor,
+        which only reflects direct formatting and the cell style, this
+        property also takes conditional formatting into account: the color
+        of a matching color scale, otherwise the background of the cell style
+        applied by a matching condition, otherwise the cell's own background.
+        -1 means transparent.</p>
+
+        @since LibreOffice 26.8
+     */
+    [optional, readonly, property] long DisplayedCellBackColor;
 };
 
 
