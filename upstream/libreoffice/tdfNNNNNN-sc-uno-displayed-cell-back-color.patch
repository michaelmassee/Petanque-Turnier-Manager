     m_pDoc->DeleteTab(0);
 }
 
+CPPUNIT_TEST_FIXTURE(TestCondformat, testDisplayedCellBackColor)
+{
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+
+    // The "Result" style applied by the condition gets a red background.
+    SfxStyleSheetBase* pStyle = m_pDoc->GetStyleSheetPool()->Find(
+        ScResId(STR_STYLENAME_RESULT), SfxStyleFamily::Para);
+    CPPUNIT_ASSERT(pStyle);
+    pStyle->GetItemSet().Put(SvxBrushItem(COL_LIGHTRED, ATTR_BACKGROUND));
+
+    // A1: condition "A1>5" -> "Result" style.
+    auto pCondition = std::make_unique<ScConditionalFormat>(1, *m_pDoc);
+    pCondition->SetRange(ScRangeList(ScRange(0, 0, 0)));
+    pCondition->AddEntry(new ScCondFormatEntry(ScConditionMode::Greater, u"5"_ustr, u""_ustr,
+                                               *m_pDoc, ScAddress(0, 0, 0),
+                                               ScResId(STR_STYLENAME_RESULT)));
+    sal_uInt32 nConditionKey = m_pDoc->AddCondFormat(std::move(pCondition), 0);
+    m_pDoc->AddCondFormatData(ScRange(0, 0, 0), 0, nConditionKey);
+
+    // B1: colour scale BLUE (0) .. RED (2).
+    auto pScale = std::make_unique<ScConditionalFormat>(2, *m_pDoc);
+    pScale->SetRange(ScRangeList(ScRange(1, 0, 0)));
+    ScColorScaleFormat* pColorScale = new ScColorScaleFormat(*m_pDoc);
+    pColorScale->AddEntry(new ScColorScaleEntry(0, COL_BLUE));
+    pColorScale->AddEntry(new ScColorScaleEntry(2, COL_RED));
+    pScale->AddEntry(pColorScale);
+    sal_uInt32 nScaleKey = m_pDoc->AddCondFormat(std::move(pScale), 0);
+    m_pDoc->AddCondFormatData(ScRange(1, 0, 0), 0, nScaleKey);
+
+    rtl::Reference<ScCellObj> xA1(new ScCellObj(m_xDocShell.get(), ScAddress(0, 0, 0)));
+    rtl::Reference<ScCellObj> xB1(new ScCellObj(m_xDocShell.get(), ScAddress(1, 0, 0)));
+    auto getColor = [](const rtl::Reference<ScCellObj>& xCell, const OUString& rName) {
+        Color aColor;
+        CPPUNIT_ASSERT(xCell->getPropertyValue(rName) >>= aColor);
+        return aColor;
+    };
+
+    // Condition not met: nothing is displayed.
+    m_pDoc->SetValue(ScAddress(0, 0, 0), 1.0);
+    CPPUNIT_ASSERT_EQUAL(COL_TRANSPARENT, getColor(xA1, u"DisplayedCellBackColor"_ustr));
+
+    // Condition met: the style background is displayed, but CellBackColor
+    // keeps reporting the (unset) direct/style formatting.
+    m_pDoc->SetValue(ScAddress(0, 0, 0), 10.0);
+    CPPUNIT_ASSERT_EQUAL(COL_LIGHTRED, getColor(xA1, u"DisplayedCellBackColor"_ustr));
+    CPPUNIT_ASSERT_EQUAL(COL_TRANSPARENT, getColor(xA1, u"CellBackColor"_ustr));
+
+    // Colour scale: the scale colour for the cell's value is displayed.
+    m_pDoc->SetValue(ScAddress(1, 0, 0), 2.0);
+    CPPUNIT_ASSERT_EQUAL(COL_RED, getColor(xB1, u"DisplayedCellBackColor"_ustr));
+    CPPUNIT_ASSERT_EQUAL(COL_TRANSPARENT, getColor(xB1, u"CellBackColor"_ustr));
+
+    // Without conditional formatting both properties agree.
+    m_pDoc->ApplyAttr(2, 0, 0, SvxBrushItem(COL_YELLOW, ATTR_BACKGROUND));
+    rtl::Reference<ScCellObj> xC1(new ScCellObj(m_xDocShell.get(), ScAddress(2, 0, 0)));
+    CPPUNIT_ASSERT_EQUAL(COL_YELLOW, getColor(xC1, u"DisplayedCellBackColor"_ustr));
+    CPPUNIT_ASSERT_EQUAL(COL_YELLOW, getColor(xC1, u"CellBackColor"_ustr));
+
+    m_pDoc->DeleteTab(0);
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
