-              || pEntry->nWID == SC_WID_UNO_CELLCONTENTTYPE )
+              || pEntry->nWID == SC_WID_UNO_CELLCONTENTTYPE || pEntry->nWID == SC_WID_UNO_DISPCELLBACK )
     {
         //  Read-Only
         //! Exception or so...
@@ -6324,6 +6358,10 @@ void ScCellObj::GetOnePropertyValue( const SfxItemPropertyMapEntry* pEntry, uno:
         table::CellContentType eType = GetContentType_Impl();
